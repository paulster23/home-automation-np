<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ──────────────────────────────────────────────────────────────────────
         go-librespot — production Spotify Connect receiver ("Naboo"). JOB 1 of 2.
         Runs ONLY go-librespot (run-naboo.sh) → writes PCM to the FIFO. The
         stream side (ffmpeg + serve_http :8765 + go-event) is a separate job:
         com.naboo.stream. This split is the 2026-06-13 storm fix — see
         run-naboo.sh and TROUBLESHOOTING.md 2026-06-13.

         Install / reload:
           cp ~/containers/home-automation/librespot/com.go-librespot.naboo.plist \
              ~/Library/LaunchAgents/
           launchctl bootout  gui/$(id -u)/com.go-librespot.naboo 2>/dev/null
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.go-librespot.naboo.plist

         ThrottleInterval=30 + the rate guard in run-naboo.sh cap respawns at
         once / 30s so a failing start can never storm the host.

         Logs: ~/containers/home-automation/librespot/log/
    ────────────────────────────────────────────────────────────────────────── -->

    <key>Label</key>
    <string>com.go-librespot.naboo</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/media/containers/home-automation/librespot/run-naboo.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Restart-storm safety net: never relaunch more than once per 30s. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/media/containers/home-automation/librespot/log/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/media/containers/home-automation/librespot/log/launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/media</string>
    </dict>
</dict>
</plist>
