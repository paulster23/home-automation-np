<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ──────────────────────────────────────────────────────────────────────
         Librespot watchdog — checks every 5 minutes that librespot is running
         and port 8765 is open. Restarts via launchctl kickstart if not.

         Install:
           chmod +x ~/containers/home-automation/librespot/watchdog.sh
           cp ~/containers/home-automation/librespot/com.librespot.naboo-watchdog.plist \
              ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.librespot.naboo-watchdog.plist

         Uninstall:
           launchctl unload ~/Library/LaunchAgents/com.librespot.naboo-watchdog.plist
           rm ~/Library/LaunchAgents/com.librespot.naboo-watchdog.plist

         Run manually to test:
           bash ~/containers/home-automation/librespot/watchdog.sh
           tail ~/containers/home-automation/librespot/log/watchdog.log

         Logs: ~/containers/home-automation/librespot/log/watchdog.log
    ────────────────────────────────────────────────────────────────────────── -->

    <key>Label</key>
    <string>com.librespot.naboo-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/media/containers/home-automation/librespot/watchdog.sh</string>
    </array>

    <!-- Run every 5 minutes -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Also run once at load time -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/media/containers/home-automation/librespot/log/watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/media/containers/home-automation/librespot/log/watchdog.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/media</string>
    </dict>
</dict>
</plist>
