<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ──────────────────────────────────────────────────────────────────────
         Librespot HTTP server — persistent serve_http.py on port 8765.

         Runs independently of the librespot|ffmpeg pipeline. Reads from
         /tmp/librespot.fifo and serves audio to a single HTTP client.
         Port 8765 stays up permanently — naboo can always connect.

         Install:
           cp ~/containers/home-automation/librespot/com.librespot.naboo-http.plist \
              ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.librespot.naboo-http.plist

         Reload after changes to serve_http.py:
           launchctl unload ~/Library/LaunchAgents/com.librespot.naboo-http.plist
           launchctl load   ~/Library/LaunchAgents/com.librespot.naboo-http.plist

         Logs: ~/containers/home-automation/librespot/log/
    ────────────────────────────────────────────────────────────────────────── -->

    <key>Label</key>
    <string>com.librespot.naboo-http</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/media/containers/home-automation/librespot/serve_http.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/media/containers/home-automation/librespot/log/http.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/media/containers/home-automation/librespot/log/http.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/media</string>
    </dict>
</dict>
</plist>
