<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wyoming.whisperkit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/media/containers/home-automation/wyoming-whisperkit/wyoming-whisperkit.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/media/containers/home-automation/wyoming-whisperkit</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/media/containers/home-automation/wyoming-whisperkit/log/whisper.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/media/containers/home-automation/wyoming-whisperkit/log/whisper.err</string>

  <!-- Delay 30 s after login so Docker and HA have time to start first -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
