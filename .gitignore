# ── macOS ────────────────────────────────────
.DS_Store

# ── Secrets (API keys, passwords) ───────────
secrets/

# ── TLS certificates (private key must never be committed) ───────────
certs/privkey.pem
certs/*.key

# ── MQTT broker auth ─────────────────────────────────────────────────
mosquitto/config/password_file

# ── Frigate runtime data ────────────────────
# Database (all variants: -shm, -wal, .bak-*, backups)
frigate/frigate.db*
frigate/backup.db
frigate/*.db.bak*
frigate/.exports
frigate/.jwt_secret
frigate/.timeline
frigate/.vacuum
frigate/model_cache/
frigate/storage/

# ── Frigate config backups (auto-generated on upgrade) ──
frigate/config.yml.bak*
frigate/*.bak-*

# ── Home Assistant runtime data ─────────────
# Everything in here is auto-generated on first run.
# Customized config files are force-tracked with git add -f:
#   homeassistant/automations.yaml
#   homeassistant/configuration.yaml
#   homeassistant/custom_sentences/
# All other HA runtime files (DB, .storage, themes, etc.) are ignored.
homeassistant/

# ── Music Assistant runtime data ────────────
music-assistant/

# ── Wyoming MLX Whisper (native macOS install, has its own repo) ──
wyoming-mlx-whisper/
frigate/.fuse_hidden*
# ── Python virtual environments ─────────────
**/.venv/
**/venv/
**/__pycache__/

# ── Runtime logs & bench output (untracked in REORG Phase 0, 2026-06-09) ──
librespot/log/
voice-bench/log/
voice-bench/data/
wyoming-whisperkit/log/

# ── go-librespot runtime state — state.json holds Spotify credentials, never commit ──
librespot/go-config/state.json
librespot/go-config/lockfile

# ── Stream Deck compiled launchers (rebuild with streamdeck/rebuild_apps.sh) ──
streamdeck/*.app/
streamdeck/*.log
.claude/settings.local.json

# ── Host-specific compose overrides (woodhull migration, 2026-08-31) ──
.env

# ── Per-site override symlink (points at overrides/<site>.yml) ──
docker-compose.override.yml

# Timestamped backups np-day-one.sh makes before swapping in the NP config
frigate/config.bk-*.yml

# ── Archived Brooklyn HA clone, kept as the New Paltz rollback (2026-09-14) ──
# 661 MB. Never commit it. `mv` it back over homeassistant/ to roll back.
#
# ⚠️ REVERSED 2026-09-14 by the repo split. The note that used to sit here told
# you these files stay permanently modified and must NOT be committed, because
# this branch was shared with Brooklyn and committing would overwrite its
# config. That is no longer true and following it now would be wrong: this repo
# is New Paltz only, and configuration.yaml / automations.yaml / scripts.yaml
# ARE committed here as of 299439f. Commit NP config changes normally.
#
# Note homeassistant/ is ignored above as runtime data, so adding a NEW config
# file needs: git add -f homeassistant/<file>.
homeassistant.bk-clone-*/
