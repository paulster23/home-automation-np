#!/usr/bin/env bash
# pre-push hook: scan outgoing commits for secrets before they leave your machine.
# Install: cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#  -or-    run: hooks/install.sh
#
# Uses gitleaks if available (brew install gitleaks), otherwise falls back to
# a lightweight regex scan tailored to this homelab's known secret patterns.

set -euo pipefail

RED='\033[0;31m'
YEL='\033[0;33m'
GRN='\033[0;32m'
NC='\033[0m'

REMOTE="$1"
URL="$2"

# Collect the range of commits being pushed
COMMITS=()
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions
  [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue

  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    # New branch — scan from the beginning up to this commit
    COMMITS+=("$local_sha")
    RANGE="$local_sha"
  else
    RANGE="$remote_sha..$local_sha"
  fi
done

if [[ ${#COMMITS[@]} -eq 0 && -z "${RANGE:-}" ]]; then
  exit 0  # Nothing to push
fi

echo -e "${YEL}[pre-push] Scanning commits for secrets (${RANGE:-${COMMITS[*]}})...${NC}"

# ── 1. gitleaks (preferred) ───────────────────────────────────────────────────
if command -v gitleaks &>/dev/null; then
  if gitleaks detect \
      --source . \
      --log-opts "${RANGE:-HEAD}" \
      --redact \
      --no-banner \
      --exit-code 1 2>/dev/null; then
    echo -e "${GRN}[pre-push] gitleaks: no secrets found. ✓${NC}"
  else
    echo -e "${RED}[pre-push] gitleaks found secrets in the commits you're about to push!${NC}"
    echo -e "${RED}           Push blocked. Fix the issues above before pushing.${NC}"
    echo ""
    echo "  Tips:"
    echo "  • Move secrets to ./secrets/ (already in .gitignore)"
    echo "  • Use Docker secrets or env files referenced in .gitignore"
    echo "  • If it's a false positive: git push --no-verify  (use sparingly)"
    exit 1
  fi

# ── 2. Fallback: regex scan on git diff ──────────────────────────────────────
else
  echo -e "${YEL}[pre-push] gitleaks not found — using built-in pattern scan.${NC}"
  echo -e "${YEL}           Run 'brew install gitleaks' for more thorough detection.${NC}"

  DIFF=$(git diff --unified=0 "${RANGE:-HEAD}" -- . \
    ':(exclude)*.md' \
    ':(exclude).gitignore' \
    ':(exclude)hooks/' \
    2>/dev/null || true)

  FOUND=0

  # PEM private keys
  if echo "$DIFF" | grep -qE '^\+.*(-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY)'; then
    echo -e "${RED}  ✗ PEM private key detected${NC}"
    FOUND=1
  fi

  # JWT tokens (3-part base64url)
  if echo "$DIFF" | grep -qE '^\+.*eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+'; then
    echo -e "${RED}  ✗ JWT token detected${NC}"
    FOUND=1
  fi

  # Home Assistant long-lived tokens (--hass-token flag)
  if echo "$DIFF" | grep -qE '^\+.*--hass-token\s+\S+'; then
    echo -e "${RED}  ✗ Home Assistant --hass-token detected in compose/script${NC}"
    FOUND=1
  fi

  # Generic API keys (common patterns: SECRET=, KEY=, TOKEN=, PASSWORD=)
  if echo "$DIFF" | grep -qiE '^\+[^#].*(secret|api_key|api-key|password|passwd|token)\s*[=:]\s*[A-Za-z0-9+/]{16,}'; then
    echo -e "${RED}  ✗ Possible hardcoded credential (SECRET/KEY/TOKEN/PASSWORD assignment)${NC}"
    FOUND=1
  fi

  # Frigate JWT secret file
  if echo "$DIFF" | grep -qE '^\+\+\+ .*/\.jwt_secret'; then
    echo -e "${RED}  ✗ Frigate .jwt_secret file detected${NC}"
    FOUND=1
  fi

  # Mosquitto password file (hashed but still sensitive)
  if echo "$DIFF" | grep -qE '^\+\+\+ .*/password_file'; then
    echo -e "${RED}  ✗ Mosquitto password_file detected${NC}"
    FOUND=1
  fi

  if [[ $FOUND -eq 1 ]]; then
    echo ""
    echo -e "${RED}[pre-push] Secrets detected — push blocked.${NC}"
    echo ""
    echo "  Tips:"
    echo "  • Move secrets to ./secrets/ (already in .gitignore)"
    echo "  • Use Docker secrets or env files referenced in .gitignore"
    echo "  • If it's a false positive: git push --no-verify  (use sparingly)"
    echo "  • Install gitleaks for better coverage: brew install gitleaks"
    exit 1
  else
    echo -e "${GRN}[pre-push] Pattern scan: no secrets found. ✓${NC}"
  fi
fi

exit 0
