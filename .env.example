# Copy to .env on each host running this compose file. Never commit .env itself.
# The ${HOST_IP:?} guard in docker-compose.yml means a host with no .env fails
# loudly instead of binding the wrong address — that is deliberate, keep it.

# ── woodhull (Brooklyn) — current ────────────────────────────
HOST_IP=192.168.1.71
FRIGATE_MEDIA=/srv/frigate

# ── media / the M1 (New Paltz) ───────────────────────────────
# Use with:  ln -s overrides/np.yml docker-compose.override.yml
# HOST_IP=192.168.2.70
# FRIGATE_MEDIA=./frigate/storage
